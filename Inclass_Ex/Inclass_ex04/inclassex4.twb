            <column caption='Z-score' datatype='real' name='[Calculation_0792234311114752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#13;&#10;WHEN &quot;99%&quot; THEN 2.58&#13;&#10;WHEN &quot;95%&quot; THEN 1.96&#13;&#10;WHEN &quot;90%&quot; THEN 1.64&#13;&#10;END' />
            </column>
            <column caption='Marginal Error Left' datatype='real' name='[Calculation_0792234315005955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Proportion Reproducible])-MIN([Calculation_0792234311114752])*(STDEV([Proportion Reproducible])/SQRT(COUNT([respid])))' />
            </column>
            <column caption='Marginal Error Right' datatype='real' name='[Calculation_0792234315972612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Proportion Reproducible])+MIN([Calculation_0792234311114752])*(STDEV([Proportion Reproducible])/SQRT(COUNT([respid])))' />
            </column>
            <column datatype='real' name='[Proportion Reproducible]' role='measure' type='quantitative' />
            <column-instance column='[Proportion Reproducible]' derivation='Avg' name='[avg:Proportion Reproducible:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Area of Interest]' derivation='None' name='[none:Area of Interest:nk]' pivot='key' type='nominal' />
            <column aggregation='Sum' caption='Respid' datatype='integer' name='[respid]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0792234315005955]' derivation='User' name='[usr:Calculation_0792234315005955:qk]' pivot='key' type='quantitative' />
